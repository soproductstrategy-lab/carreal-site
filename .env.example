# URL publique du site (canonical, sitemap, JSON-LD)
# En démo Vercel, laisser vide (utilise automatiquement l'URL *.vercel.app) ou indiquer https://<projet>.vercel.app
NEXT_PUBLIC_SITE_URL=https://www.carreal.fr
# Mettre à "true" en pré-production / démo pour bloquer toute indexation Google (supprimer ou "false" en prod sur carreal.fr)
NEXT_PUBLIC_NOINDEX=true

# Sanity (sanity.io/manage) — sans ces valeurs, le site utilise le contenu local de src/content/
NEXT_PUBLIC_SANITY_PROJECT_ID=vl62tcyg
NEXT_PUBLIC_SANITY_DATASET=production
# Jeton « Editor » pour le script d'import uniquement (npm run sanity:seed). Ne jamais le committer.
SANITY_API_WRITE_TOKEN=
# Secret partagé avec le webhook Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Assistant IA intégré dans /studio (clé Google AI Studio : https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optionnel : modèle Gemini utilisé par l'assistant (défaut : gemini-4-hydrogen)
# GEMINI_MODEL=gemini-4-hydrogen

# Envoi des demandes de devis (resend.com). Sans clé : enregistrement local dans .leads/
RESEND_API_KEY=
QUOTE_TO=carreal.sarl@orange.fr
QUOTE_FROM=Site Carreal <devis@carreal.fr>

